NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# 運営ダッシュボード用（サーバーのみ。Vercel にも設定）
SUPABASE_SERVICE_ROLE_KEY=
# 運営管理者メール（カンマ区切り。未設定時は kigyouman8686@gmail.com）
# APP_ADMIN_EMAILS=kigyouman8686@gmail.com
# 本番 URL（Vercel 等）。OG / メタデータの絶対パス用。未設定でも動くが iOS・共有時は設定推奨
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# AIメンター（未設定のままなら休止メッセージのみ。使うときに貼る）
OPENAI_API_KEY=

# プロジェクト AI（Gemini・3種: ロードマップ / 相談 / アイデア編）
# https://aistudio.google.com/apikey （新キーは AQ. で始まる）
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# プロジェクトルーム AI コーチ（Anthropic・レガシーAPI）（今日のToDo・フェーズゴール・詰まり相談）。未設定ならサンプル応答
ANTHROPIC_API_KEY=
# 任意（例: claude-sonnet-4-20250514）
ANTHROPIC_MODEL=

# Daily（アプリ内通話）
# 例: DAILY_DOMAIN=your-team.daily.co
DAILY_API_KEY=
DAILY_DOMAIN=
# 任意（通常は変更不要）
# DAILY_API_BASE=https://api.daily.co/v1
